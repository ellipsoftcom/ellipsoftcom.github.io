---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLabel from '../components/ArrowLabel.astro';
import type { Locale } from '../i18n/ui';
import { getDictionary, localizedPath } from '../i18n/utils';
import { products } from '../data/products';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const p = t.pages.about;

// "Our products" section links to the first catalogue product (Waraq).
const featured = products[0];
const featuredHref = localizedPath(locale, `/products/${featured.slug}/`);
---

<BaseLayout locale={locale} title={p.title} description={p.description} pagePath="/about/">
  {/* Hero. */}
  <section class="page-hero">
    <div class="container">
      <h1>{p.heroTitle}</h1>
      <p>{p.heroSubtitle}</p>
    </div>
  </section>

  {/* Who is behind EllipSoft. */}
  <section class="container section">
    <h2>{p.behindHeading}</h2>
    <p>{p.behindText}</p>
  </section>

  {/* How we work. */}
  <section class="container section">
    <h2>{p.workHeading}</h2>
    <ul class="titled-list">
      {
        p.workItems.map((item) => (
          <li>
            <strong>{item.title}</strong> — {item.text}
          </li>
        ))
      }
    </ul>
  </section>

  {/* Our products. */}
  <section class="container section">
    <h2>{p.productsHeading}</h2>
    <p>{p.productsText}</p>
    <a class="products-link" href={featuredHref}><ArrowLabel text={p.productsLink} /></a>
  </section>

  {/* Call to action. */}
  <section class="container section cta">
    <h2>{p.ctaHeading}</h2>
    <a class="button" href={localizedPath(locale, '/contact/')}>{p.ctaLabel}</a>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-16) var(--space-12);
    border-block-end: 1px solid var(--color-border);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .page-hero p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    max-width: 60ch;
  }

  .section {
    padding-block: var(--space-12);
  }

  .section h2 {
    font-size: var(--text-2xl);
  }

  .section p {
    max-width: 65ch;
  }

  .titled-list {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 65ch;
  }

  .titled-list li {
    position: relative;
    padding-inline-start: var(--space-5);
  }

  .titled-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }

  .titled-list strong {
    font-weight: 600;
  }

  .products-link {
    display: inline-block;
    margin-block-start: var(--space-2);
    color: var(--color-accent);
    font-weight: 600;
  }

  .products-link:hover {
    color: var(--color-accent-strong);
  }

  .cta {
    padding-block: var(--space-12) var(--space-16);
  }
</style>
